# Sibling repositories kept for reference/porting; not part of this repo's history.
# Contents are ignored, but README.md (how to fetch each one) is tracked.
/external_repos/*
!/external_repos/README.md

# Build artifacts
/build/
/build-*/
**/CMakeFiles/
**/CMakeCache.txt
**/*.o
**/*.a
**/*.so

# Generated protobuf/codegen output (regenerated by tools/codegen)
**/generated/
**/*_pb2.py
**/*.pb.cc
**/*.pb.h

# Python
**/__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Run artifacts
/outputs/
*.mcap
!tests/**/*.mcap

# Editor/OS/tooling
.vscode/
.idea/
.claude/
*.swp
.DS_Store
